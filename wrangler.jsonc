{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c5af1bf4-fff6-42fe-ae7d-108380f7e58f","database_name": "web-appp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "98244d5ede7f43fa8417b23c11d7b15d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
